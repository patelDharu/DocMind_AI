# =========================================================
# DocMind AI — Environment Configuration
# =========================================================

# Google Gemini API Key (Required)
# Obtain your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Primary LLM Generation Model
# Defaults to gemini-flash-lite-latest (with automatic multi-model failover cascade)
# Options: gemini-flash-lite-latest, gemini-2.5-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-flash-lite-latest

# Gemini Dense Embedding Model
# Defaults to gemini-embedding-001 (with fallback cascade to text-embedding-004)
# Options: gemini-embedding-001, text-embedding-004
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Backend Server Host & Port
API_HOST=127.0.0.1
API_PORT=8000

# Optional Master System API Key for External Integrations & CLI Admin Access
# Callers can pass header: `Authorization: Bearer <key>` or `X-API-Key: <key>`
DOCMIND_API_KEY=your_optional_master_api_key_here

# =========================================================
# 3rd-Party Object Storage (AWS S3 / MinIO / Cloudflare R2 / Supabase)
# If configured, uploaded documents and exports are stored persistently in S3.
# If omitted, DocMind AI safely falls back to local storage in app/data/uploads.
# =========================================================
# STORAGE_BACKEND=s3
# S3_BUCKET_NAME=your-bucket-name
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_REGION=us-east-1
# S3_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com # Or custom URL for MinIO, Cloudflare R2, Supabase
# S3_PREFIX=documents/